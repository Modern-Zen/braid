@@ -0,0 +1,53 @@
+import { useState } from "react";
+import type { GaugeKind } from "../types";
+
+export interface UseGaugeOptions {
+  kind: GaugeKind;
+  /** Reading in US units: feet (stage), cubic feet per second (flow), °F (temp). */
+  value: number;
+  min: number;
+  max: number;
+  alertAt?: number;
+  defaultUnits?: "us" | "metric";
+}
+
+export interface GaugeState {
+  /** The reading in the current units, e.g. "6.2 ft" or "1.9 m". */
+  reading: string;
+  /** Bar fill as a percentage of the range, clamped to 0–100. */
+  pct: number;
+  /** At or above the alert threshold. */
+  alert: boolean;
+  metric: boolean;
+  toggleUnits: () => void;
+}
+
+/** Unit state, conversion, formatting and bar math for a Gauge. */
+export function useGauge({ kind, value, min, max, alertAt, defaultUnits = "us" }: UseGaugeOptions): GaugeState {
+  const [units, setUnits] = useState(defaultUnits);
+  const metric = units === "metric";
+
+  let shown = value;
+  let unit = "ft";
+  if (kind === "stage") {
+    shown = metric ? value * 0.3048 : value;
+    unit = metric ? "m" : "ft";
+  } else if (kind === "flow") {
+    shown = metric ? value * 0.0283168 : value;
+    unit = metric ? "m³/s" : "cfs";
+  } else {
+    shown = metric ? ((value - 32) * 5) / 9 : value;
+    unit = metric ? "°C" : "°F";
+  }
+
+  let reading: string;
+  if (kind === "temp") reading = `${Math.round(shown)}${unit}`;
+  else if (kind === "flow" && !metric) reading = `${Math.round(shown).toLocaleString("en-US")} ${unit}`;
+  else reading = `${shown.toFixed(1)} ${unit}`;
+
+  const span = max - min;
+  const pct = span > 0 ? Math.min(100, Math.max(0, ((value - min) / span) * 100)) : 0;
+  const alert = alertAt !== undefined && value >= alertAt;
+
+  return { reading, pct, alert, metric, toggleUnits: () => setUnits(metric ? "us" : "metric") };
+}
