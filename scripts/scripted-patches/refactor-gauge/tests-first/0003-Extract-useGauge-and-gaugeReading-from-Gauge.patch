@@ -0,0 +1,66 @@
+import { useState } from "react";
+import type { GaugeKind } from "../types";
+
+export type Units = "us" | "metric";
+
+export interface GaugeInput {
+  kind: GaugeKind;
+  /** Reading in US units: feet (stage), cubic feet per second (flow), °F (temp). */
+  value: number;
+  min: number;
+  max: number;
+  alertAt?: number;
+}
+
+export interface GaugeReading {
+  /** The reading in the requested units, e.g. "6.2 ft" or "1.9 m". */
+  reading: string;
+  /** Bar fill as a percentage of the range, clamped to 0–100. */
+  pct: number;
+  /** At or above the alert threshold. */
+  alert: boolean;
+}
+
+export interface UseGauge extends GaugeReading {
+  units: Units;
+  toggleUnits: () => void;
+}
+
+/** What a gauge shows for an input in the given units. Pure. */
+export function gaugeReading({ kind, value, min, max, alertAt }: GaugeInput, units: Units): GaugeReading {
+  const metric = units === "metric";
+
+  let shown = value;
+  let unit = "ft";
+  if (kind === "stage") {
+    shown = metric ? value * 0.3048 : value;
+    unit = metric ? "m" : "ft";
+  } else if (kind === "flow") {
+    shown = metric ? value * 0.0283168 : value;
+    unit = metric ? "m³/s" : "cfs";
+  } else {
+    shown = metric ? ((value - 32) * 5) / 9 : value;
+    unit = metric ? "°C" : "°F";
+  }
+
+  let reading: string;
+  if (kind === "temp") reading = `${Math.round(shown)}${unit}`;
+  else if (kind === "flow" && !metric) reading = `${Math.round(shown).toLocaleString("en-US")} ${unit}`;
+  else reading = `${shown.toFixed(1)} ${unit}`;
+
+  const span = max - min;
+  const pct = span > 0 ? Math.min(100, Math.max(0, ((value - min) / span) * 100)) : 0;
+  const alert = alertAt !== undefined && value >= alertAt;
+
+  return { reading, pct, alert };
+}
+
+/** gaugeReading plus the reader's unit choice, which a click toggles. */
+export function useGauge({ defaultUnits = "us", ...input }: GaugeInput & { defaultUnits?: Units }): UseGauge {
+  const [units, setUnits] = useState<Units>(defaultUnits);
+  return {
+    ...gaugeReading(input, units),
+    units,
+    toggleUnits: () => setUnits(units === "metric" ? "us" : "metric"),
+  };
+}
