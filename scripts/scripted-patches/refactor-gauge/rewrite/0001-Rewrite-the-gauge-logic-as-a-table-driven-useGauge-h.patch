From 5c9880366dcfde01a9d63f4623359588d486c62b Mon Sep 17 00:00:00 2001
From: Headwaters <agents@braid.drp.icu>
Date: Mon, 12 Oct 2026 13:44:44 -0700
Subject: [PATCH 1/3] Rewrite the gauge logic as a table-driven useGauge hook

src/hooks/useGauge.ts describes every kind in both unit systems in one
SCALES table (unit, conversion, Intl number format), exposes
formatReading and fillPercent as pure helpers, and returns prop getters
for the meter and the unit toggle so the ARIA wiring lives with the
logic. Gauge doesn't use it yet.
---
 src/hooks/useGauge.ts | 81 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 src/hooks/useGauge.ts

diff --git a/src/hooks/useGauge.ts b/src/hooks/useGauge.ts
new file mode 100644
index 0000000..171130f
--- /dev/null
+++ b/src/hooks/useGauge.ts
@@ -0,0 +1,81 @@
+import { useState, type ButtonHTMLAttributes, type HTMLAttributes } from "react";
+import type { GaugeKind, Reading } from "../types";
+
+export type Units = "us" | "metric";
+
+interface Scale {
+  unit: string;
+  /** From the API's US value (ft, cfs, °F) to this scale. */
+  convert: (value: number) => number;
+  format: Intl.NumberFormat;
+  /** "6.2 ft" has a space; "51°F" doesn't. */
+  spaced: boolean;
+}
+
+const decimals = (digits: number) =>
+  new Intl.NumberFormat("en-US", { minimumFractionDigits: digits, maximumFractionDigits: digits });
+
+/** Every kind in both unit systems: unit label, conversion, and number format. */
+export const SCALES: Record<GaugeKind, Record<Units, Scale>> = {
+  stage: {
+    us: { unit: "ft", convert: (ft) => ft, format: decimals(1), spaced: true },
+    metric: { unit: "m", convert: (ft) => ft * 0.3048, format: decimals(1), spaced: true },
+  },
+  flow: {
+    us: { unit: "cfs", convert: (cfs) => cfs, format: decimals(0), spaced: true },
+    metric: { unit: "m³/s", convert: (cfs) => cfs * 0.0283168, format: decimals(1), spaced: true },
+  },
+  temp: {
+    us: { unit: "°F", convert: (f) => f, format: decimals(0), spaced: false },
+    metric: { unit: "°C", convert: (f) => ((f - 32) * 5) / 9, format: decimals(0), spaced: false },
+  },
+};
+
+export function formatReading(kind: GaugeKind, value: number, units: Units): string {
+  const scale = SCALES[kind][units];
+  return `${scale.format.format(scale.convert(value))}${scale.spaced ? " " : ""}${scale.unit}`;
+}
+
+export function fillPercent({ value, min, max }: Reading): number {
+  const span = max - min;
+  return span > 0 ? Math.min(100, Math.max(0, ((value - min) / span) * 100)) : 0;
+}
+
+export interface UseGauge {
+  units: Units;
+  text: string;
+  pct: number;
+  alert: boolean;
+  toggleUnits: () => void;
+  /** Spread onto the track element: role="meter" and its ARIA values. */
+  getMeterProps: () => HTMLAttributes<HTMLElement>;
+  /** Spread onto the value button: switches units on click. */
+  getToggleProps: () => ButtonHTMLAttributes<HTMLButtonElement>;
+}
+
+/** Everything a gauge needs to render a reading, with the reader's unit choice. */
+export function useGauge(kind: GaugeKind, label: string, reading: Reading, defaultUnits: Units = "us"): UseGauge {
+  const [units, setUnits] = useState<Units>(defaultUnits);
+  const text = formatReading(kind, reading.value, units);
+  const toggleUnits = () => setUnits((u) => (u === "metric" ? "us" : "metric"));
+  return {
+    units,
+    text,
+    pct: fillPercent(reading),
+    alert: reading.alertAt !== undefined && reading.value >= reading.alertAt,
+    toggleUnits,
+    getMeterProps: () => ({
+      role: "meter",
+      "aria-label": label,
+      "aria-valuemin": reading.min,
+      "aria-valuemax": reading.max,
+      "aria-valuenow": reading.value,
+      "aria-valuetext": text,
+    }),
+    getToggleProps: () => ({
+      type: "button",
+      title: units === "metric" ? "Show US units" : "Show metric units",
+      onClick: toggleUnits,
+    }),
+  };
+}
