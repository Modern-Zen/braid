+    alertTrack: "#431407",
+    alert: "#fb923c",
+  },
+} as const;
+
+type Units = "us" | "metric";
+
+interface Scale {
+  unit: string;
+  /** From the US reading (ft, cfs, °F) to this scale. */
+  convert: (value: number) => number;
+  digits: number;
+  /** "6.2 ft" has a space; "51°F" doesn't. */
+  spaced: boolean;
+}
+
+const SCALES: Record<GaugeKind, Record<Units, Scale>> = {
+  stage: {
+    us: { unit: "ft", convert: (v) => v, digits: 1, spaced: true },
+    metric: { unit: "m", convert: (v) => v * 0.3048, digits: 1, spaced: true },
+  },
+  flow: {
+    us: { unit: "cfs", convert: (v) => v, digits: 0, spaced: true },
+    metric: { unit: "m³/s", convert: (v) => v * 0.0283168, digits: 1, spaced: true },
+  },
+  temp: {
+    us: { unit: "°F", convert: (v) => v, digits: 0, spaced: false },
+    metric: { unit: "°C", convert: (v) => ((v - 32) * 5) / 9, digits: 0, spaced: false },
+  },
+};
+
 export interface GaugeProps {
   kind: GaugeKind;
   label: string;
@@ -12,41 +58,40 @@ export interface GaugeProps {
   /** At or above this value the bar switches to the alert color. */
   alertAt?: number;
   /** Units shown until the reader clicks the value to switch. */
-  defaultUnits?: "us" | "metric";
+  defaultUnits?: Units;
+  scheme?: ColorScheme;
 }
 
-export function Gauge({ kind, label, value, min, max, alertAt, defaultUnits = "us" }: GaugeProps) {
-  const [units, setUnits] = useState(defaultUnits);
-  const metric = units === "metric";
-
-  let shown = value;
-  let unit = "ft";
-  if (kind === "stage") {
-    shown = metric ? value * 0.3048 : value;
-    unit = metric ? "m" : "ft";
-  } else if (kind === "flow") {
-    shown = metric ? value * 0.0283168 : value;
-    unit = metric ? "m³/s" : "cfs";
-  } else {
-    shown = metric ? ((value - 32) * 5) / 9 : value;
-    unit = metric ? "°C" : "°F";
-  }
-
-  let reading: string;
-  if (kind === "temp") reading = `${Math.round(shown)}${unit}`;
-  else if (kind === "flow" && !metric) reading = `${Math.round(shown).toLocaleString("en-US")} ${unit}`;
-  else reading = `${shown.toFixed(1)} ${unit}`;
+export function Gauge({ kind, label, value, min, max, alertAt, defaultUnits = "us", scheme = "light" }: GaugeProps) {
+  const [units, setUnits] = useState<Units>(defaultUnits);
+  const scale = SCALES[kind][units];
+  const number = scale.convert(value).toLocaleString("en-US", {
+    minimumFractionDigits: scale.digits,
+    maximumFractionDigits: scale.digits,
+  });
+  const reading = `${number}${scale.spaced ? " " : ""}${scale.unit}`;
 
   const span = max - min;
   const pct = span > 0 ? Math.min(100, Math.max(0, ((value - min) / span) * 100)) : 0;
   const alert = alertAt !== undefined && value >= alertAt;
-  const barColor = alert ? palette.alert : palette.bar;
+  const colors = GAUGE_COLORS[scheme];
 
   return (
     <div className="gauge" data-kind={kind} data-alert={alert || undefined}>
-      <span className="gauge-label" style={{ color: palette.muted }}>
-        {label}
-      </span>
+      <div className="gauge-head">
+        <span className="gauge-label" style={{ color: colors.label }}>
+          {label}
+        </span>
+        <button
+          type="button"
+          className="gauge-value"
+          title={units === "metric" ? "Show US units" : "Show metric units"}
+          onClick={() => setUnits(units === "metric" ? "us" : "metric")}
+          style={{ color: colors.value }}
+        >
+          {reading}
+        </button>
+      </div>
       <div
         className="gauge-track"
         role="meter"
@@ -55,19 +100,13 @@ export function Gauge({ kind, label, value, min, max, alertAt, defaultUnits = "u
         aria-valuemax={max}
         aria-valuenow={value}
         aria-valuetext={reading}
-        style={{ background: `${barColor}22` }}
+        style={{ background: alert ? colors.alertTrack : colors.track }}
       >
-        <div className="gauge-bar" style={{ width: `${Math.round(pct)}%`, background: barColor }} />
+        <div
+          className="gauge-bar"
+          style={{ width: `${Math.round(pct)}%`, background: alert ? colors.alert : colors.bar }}
+        />
       </div>
-      <button
-        type="button"
-        className="gauge-value"
-        title={metric ? "Show US units" : "Show metric units"}
-        onClick={() => setUnits(metric ? "us" : "metric")}
-        style={{ color: palette.ink }}
-      >
-        {reading}
-      </button>
     </div>
