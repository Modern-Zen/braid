@@ -0,0 +1,50 @@
+import { createMiddleware } from "hono/factory";
+import type { Env } from "../../env";
+import type { LimitDecision } from "../limiter/RateLimiter";
+
+/** Seconds a refused caller is told to wait. A token refills every 100 ms, so 1 s is safe. */
+export const RETRY_AFTER_SECONDS = 1;
+
+async function sha256(text: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
+  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
+}
+
+/**
+ * Who a request counts against: its bearer token, else the client's IP.
+ * Tokens are hashed so the raw credential never becomes a Durable Object name.
+ */
+export async function limitKey(request: Request): Promise<string> {
+  const token = /^Bearer\s+(\S+)/i.exec(request.headers.get("authorization") ?? "")?.[1];
+  if (token) return `token:${await sha256(token)}`;
+  return `ip:${request.headers.get("cf-connecting-ip") ?? "unknown"}`;
+}
+
+/**
+ * 10 requests per second per caller, enforced by the RateLimiter Durable Object.
+ * Over the limit: 429 `{ error: "rate_limited", retryAfter: 1 }` and `Retry-After: 1`.
+ *
+ * Fails open: without the binding (`pnpm dev`, unit tests) or if the limiter
+ * can't be reached, the request goes through and the failure is logged.
+ */
+export function rateLimit() {
+  return createMiddleware<{ Bindings: Env }>(async (c, next) => {
+    const limiter = c.env?.RATE_LIMITER;
+    if (!limiter) return next();
+
+    let decision: LimitDecision | null = null;
+    try {
+      const stub = limiter.get(limiter.idFromName(await limitKey(c.req.raw)));
+      const res = await stub.fetch("https://rate-limiter/take", { method: "POST" });
+      decision = (await res.json()) as LimitDecision;
+    } catch (err) {
+      console.error("rate limiter unavailable; allowing the request", err);
+    }
+
+    if (decision && !decision.allowed) {
+      c.header("Retry-After", String(RETRY_AFTER_SECONDS));
+      return c.json({ error: "rate_limited", retryAfter: RETRY_AFTER_SECONDS }, 429);
+    }
+    await next();
+  });
+}
diff --git a/test/rate-limit.test.ts b/test/rate-limit.test.ts
