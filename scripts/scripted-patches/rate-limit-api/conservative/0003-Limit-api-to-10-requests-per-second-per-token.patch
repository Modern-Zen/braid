@@ -1,5 +1,46 @@
-import { describe, expect, it } from "vitest";
+import { describe, expect, it, vi } from "vitest";
 import { API_LIMIT, fullBucket, take, type BucketState } from "../src/api/limiter/bucket";
+import { RateLimiter } from "../src/api/limiter/RateLimiter";
+import type { Env } from "../src/env";
+import { app } from "../src/worker";
+
+/**
+ * A RATE_LIMITER binding backed by real RateLimiter instances on a test clock,
+ * one per name, the way the runtime addresses Durable Objects.
+ */
+function limiterEnv(clock = { now: 0 }) {
+  class TestLimiter extends RateLimiter {
+    protected override now() {
+      return clock.now;
+    }
+  }
+  const instances = new Map<string, TestLimiter>();
+  const names: string[] = [];
+  const env: Env = {
+    RATE_LIMITER: {
+      idFromName(name) {
+        names.push(name);
+        return name;
+      },
+      get(id) {
+        const key = String(id);
+        const instance = instances.get(key) ?? new TestLimiter();
+        instances.set(key, instance);
+        return { fetch: (input, init) => instance.fetch(new Request(input, init)) };
+      },
+    },
+  };
+  return { env, clock, names };
+}
+
+async function statuses(env: Env, n: number, headers: Record<string, string>) {
+  const out: number[] = [];
+  for (let i = 0; i < n; i++) out.push((await app.request("/api/levels", { headers }, env)).status);
+  return out;
+}
+
+const alice = { authorization: "Bearer alice-token" };
+const bob = { authorization: "Bearer bob-token" };
 
 /** Take `n` times at `now`, returning how many were allowed and the final state. */
 function burst(state: BucketState, n: number, now: number) {
@@ -35,3 +76,54 @@ describe("token bucket", () => {
     expect(take(empty, API_LIMIT, -5_000).allowed).toBe(false);
   });
 });
+
+describe("/api rate limit", () => {
+  it("answers the 11th request in a second with 429 and a retry hint", async () => {
+    const { env } = limiterEnv();
+    expect(await statuses(env, 10, alice)).toEqual(Array(10).fill(200));
+    const res = await app.request("/api/levels", { headers: alice }, env);
+    expect(res.status).toBe(429);
+    expect(res.headers.get("retry-after")).toBe("1");
+    expect(await res.json()).toEqual({ error: "rate_limited", retryAfter: 1 });
+  });
+
+  it("counts each token separately", async () => {
+    const { env } = limiterEnv();
+    expect(await statuses(env, 11, alice)).toContain(429);
+    expect(await statuses(env, 10, bob)).toEqual(Array(10).fill(200));
+  });
+
+  it("lets a caller back in once the bucket refills", async () => {
+    const { env, clock } = limiterEnv();
+    await statuses(env, 11, alice);
+    clock.now += 1000;
+    expect(await statuses(env, 10, alice)).toEqual(Array(10).fill(200));
+  });
+
+  it("keys by a hash of the token, or by IP without one", async () => {
+    const { env, names } = limiterEnv();
+    await app.request("/api/levels", { headers: alice }, env);
+    await app.request("/api/levels", { headers: { "cf-connecting-ip": "203.0.113.7" } }, env);
+    expect(names[0]).toMatch(/^token:[0-9a-f]{64}$/);
+    expect(names[0]).not.toContain("alice-token");
+    expect(names[1]).toBe("ip:203.0.113.7");
+  });
+
+  it("fails open when the limiter can't be reached", async () => {
+    const error = vi.spyOn(console, "error").mockImplementation(() => {});
+    const env: Env = {
+      RATE_LIMITER: {
+        idFromName: (name) => name,
+        get: () => ({ fetch: () => Promise.reject(new Error("unreachable")) }),
+      },
+    };
+    expect(await statuses(env, 12, alice)).toEqual(Array(12).fill(200));
+    expect(error).toHaveBeenCalled();
+    error.mockRestore();
+  });
+
+  it("is off without the binding, as under pnpm dev", async () => {
+    const res = await Promise.all(Array.from({ length: 20 }, () => app.request("/api/levels")));
+    expect(res.map((r) => r.status)).toEqual(Array(20).fill(200));
+  });
+});
