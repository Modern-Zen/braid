From: Headwaters <agents@braid.drp.icu>
Date: Mon, 12 Oct 2026 13:36:56 -0700
Subject: [PATCH 4/4] Serve /levels from the edge cache for 60 seconds

cache(60) stores /levels in the Workers Cache API keyed by URL only
(the data is public, so Authorization doesn't split the cache), marks it
public, max-age=60, stale-while-revalidate=60, and labels X-Cache
HIT/MISS. It runs after the rate limiter, so cached hits still count,
and 429s are never stored. Tests stub the Cache API with a Map.
---
 src/api/edgeCache.ts    | 42 ++++++++++++++++++++++++++++++++++++++++
 src/api/index.ts        |  3 ++-
 test/rate-limit.test.ts | 43 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 87 insertions(+), 1 deletion(-)
 create mode 100644 src/api/edgeCache.ts

diff --git a/src/api/edgeCache.ts b/src/api/edgeCache.ts
new file mode 100644
index 0000000..d35a17f
--- /dev/null
+++ b/src/api/edgeCache.ts
@@ -0,0 +1,42 @@
+import { createMiddleware } from "hono/factory";
+
+const CACHE_NAME = "riverlevels-api";
+
+/**
+ * Serve a route from the edge cache (the Workers Cache API) for `seconds`.
+ *
+ * The data is public, so the cache key is the URL alone: the Authorization
+ * header doesn't split the cache (Hono's built-in cache middleware skips any
+ * request with Authorization, which is every API caller here). It sits after
+ * the rate limiter, so cached responses still count toward a caller's limit.
+ * Responses carry `X-Cache: HIT | MISS` and
+ * `Cache-Control: public, max-age=<seconds>, stale-while-revalidate=<seconds>`.
+ * Where there's no Cache API (Node, tests) it only sets the headers.
+ */
+export function cache(seconds: number) {
+  const cacheControl = `public, max-age=${seconds}, stale-while-revalidate=${seconds}`;
+  return createMiddleware(async (c, next) => {
+    const store = typeof caches === "undefined" ? null : await caches.open(CACHE_NAME);
+    const key = new Request(c.req.url, { method: "GET" });
+
+    const hit = await store?.match(key);
+    if (hit) {
+      const res = new Response(hit.body, hit);
+      res.headers.set("X-Cache", "HIT");
+      return res;
+    }
+
+    await next();
+    if (c.res.status !== 200) return;
+    c.res.headers.set("Cache-Control", cacheControl);
+    c.res.headers.set("X-Cache", "MISS");
+    if (!store) return;
+
+    const write = store.put(key, c.res.clone());
+    try {
+      c.executionCtx.waitUntil(write);
+    } catch {
+      await write; // no ExecutionContext outside the Workers runtime
+    }
+  });
+}
