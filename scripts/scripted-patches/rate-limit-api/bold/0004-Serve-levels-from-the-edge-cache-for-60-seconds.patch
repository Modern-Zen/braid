diff --git a/test/rate-limit.test.ts b/test/rate-limit.test.ts
index 96d0ebf..a1ca204 100644
--- a/test/rate-limit.test.ts
+++ b/test/rate-limit.test.ts
@@ -75,3 +75,46 @@ describe("rate limit", () => {
     error.mockRestore();
   });
 });
+
+/** A Cache API in a Map, standing in for the Workers edge cache. */
+function memoryCaches() {
+  const entries = new Map<string, Response>();
+  const store = {
+    match: async (req: Request) => entries.get(req.url)?.clone(),
+    put: async (req: Request, res: Response) => void entries.set(req.url, res.clone()),
+  };
+  return { caches: { open: async () => store }, entries };
+}
+
+describe("cache(60) on /levels", () => {
+  afterEach(() => vi.unstubAllGlobals());
+
+  it("marks /levels publicly cacheable for 60 seconds", async () => {
+    const [res] = await send(memoryEnv().env, 1, alice);
+    expect(res!.headers.get("cache-control")).toBe("public, max-age=60, stale-while-revalidate=60");
+    expect(res!.headers.get("x-cache")).toBe("MISS");
+  });
+
+  it("serves repeat requests from the edge cache, whoever asks", async () => {
+    const edge = memoryCaches();
+    vi.stubGlobal("caches", edge.caches);
+    const { env } = memoryEnv();
+    const [first] = await send(env, 1, alice);
+    const [second] = await send(env, 1, bob);
+    expect(first!.headers.get("x-cache")).toBe("MISS");
+    expect(second!.headers.get("x-cache")).toBe("HIT");
+    expect(second!.headers.get("ratelimit")).toBe('"burst";r=9;t=1');
+    expect(await second!.json()).toEqual(await first!.json());
+    expect(edge.entries.size).toBe(1);
+  });
+
+  it("still counts cached responses toward the limit, and never caches a 429", async () => {
+    const edge = memoryCaches();
+    vi.stubGlobal("caches", edge.caches);
+    const { env } = memoryEnv();
+    const responses = await send(env, 11, alice);
+    expect(codes(responses)).toEqual([...Array(10).fill(200), 429]);
+    expect(responses[10]!.headers.get("cache-control")).toBeNull();
+    expect(edge.entries.size).toBe(1);
+  });
+});
