diff --git a/src/dev/memoryEnv.ts b/src/dev/memoryEnv.ts
new file mode 100644
index 0000000..9999b69
--- /dev/null
+++ b/src/dev/memoryEnv.ts
@@ -0,0 +1,51 @@
+import { TokenBucket } from "../api/ratelimit/TokenBucket";
+import type { Env } from "../env";
+
+/** Durable Object storage in a Map. Values are copied in and out, like the real thing. */
+class MemoryStorage implements DurableObjectStorage {
+  private readonly data = new Map<string, unknown>();
+
+  async get<T>(key: string): Promise<T | undefined> {
+    const value = this.data.get(key);
+    return value === undefined ? undefined : (structuredClone(value) as T);
+  }
+
+  async put<T>(key: string, value: T): Promise<void> {
+    this.data.set(key, structuredClone(value));
+  }
+}
+
+/**
+ * Worker bindings for `pnpm dev` and tests: RATE_LIMITER runs real TokenBucket
+ * objects in-process, one per name, with storage in memory. `restart()` drops
+ * the live objects but keeps their storage, like the runtime evicting them.
+ */
+export function memoryEnv() {
+  const storages = new Map<string, MemoryStorage>();
+  const objects = new Map<string, TokenBucket>();
+
+  const object = (name: string): TokenBucket => {
+    let bucket = objects.get(name);
+    if (!bucket) {
+      const storage = storages.get(name) ?? new MemoryStorage();
+      storages.set(name, storage);
+      const ctx: DurableObjectState = { storage, blockConcurrencyWhile: (callback) => callback() };
+      bucket = new TokenBucket(ctx, {});
+      objects.set(name, bucket);
+    }
+    return bucket;
+  };
+
+  const env: Env = {
+    RATE_LIMITER: {
+      idFromName: (name) => ({ toString: () => name }),
+      get: (id) => object(id.toString()),
+    },
+  };
+
+  return {
+    env,
+    restart: () => objects.clear(),
+    names: () => [...storages.keys()],
+  };
+}
