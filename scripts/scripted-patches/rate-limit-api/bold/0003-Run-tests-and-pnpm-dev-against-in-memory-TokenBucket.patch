--- /dev/null
+++ b/src/dev/workers-shim.ts
@@ -0,0 +1,12 @@
+// Node stand-in for the `cloudflare:workers` module, aliased in vite.config.ts
+// for tests and `pnpm dev`. Wrangler bundles the real module; this never ships.
+
+export abstract class DurableObject<Env = unknown> {
+  protected ctx: DurableObjectState;
+  protected env: Env;
+
+  constructor(ctx: DurableObjectState, env: Env) {
+    this.ctx = ctx;
+    this.env = env;
+  }
+}
