diff --git a/test/rate-limit.test.ts b/test/rate-limit.test.ts
new file mode 100644
index 0000000..96d0ebf
--- /dev/null
+++ b/test/rate-limit.test.ts
@@ -0,0 +1,77 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { memoryEnv } from "../src/dev/memoryEnv";
+import type { Env } from "../src/env";
+import { app } from "../src/worker";
+
+const alice = { authorization: "Bearer alice-token" };
+const bob = { authorization: "Bearer bob-token" };
+
+async function send(env: Env, n: number, headers: Record<string, string>) {
+  const out: Response[] = [];
+  for (let i = 0; i < n; i++) out.push(await app.request("/api/levels", { headers }, env));
+  return out;
+}
+const codes = (responses: Response[]) => responses.map((r) => r.status);
+
+beforeEach(() => {
+  vi.useFakeTimers({ toFake: ["Date"] });
+  vi.setSystemTime(0);
+});
+afterEach(() => vi.useRealTimers());
+
+describe("rate limit", () => {
+  it("allows 10 requests a second per token, then answers 429", async () => {
+    const { env } = memoryEnv();
+    expect(codes(await send(env, 10, alice))).toEqual(Array(10).fill(200));
+    const [refused] = await send(env, 1, alice);
+    expect(refused!.status).toBe(429);
+    expect(refused!.headers.get("retry-after")).toBe("1");
+    expect(await refused!.json()).toEqual({ error: "rate_limited", retryAfter: 1 });
+  });
+
+  it("reports the policy and what's left in RateLimit headers", async () => {
+    const { env } = memoryEnv();
+    const responses = await send(env, 11, alice);
+    expect(responses[0]!.headers.get("ratelimit-policy")).toBe('"burst";q=10;w=1');
+    expect(responses[0]!.headers.get("ratelimit")).toBe('"burst";r=9;t=1');
+    expect(responses[9]!.headers.get("ratelimit")).toBe('"burst";r=0;t=1');
+    expect(responses[10]!.headers.get("ratelimit")).toBe('"burst";r=0;t=1');
+  });
+
+  it("counts each token separately", async () => {
+    const { env } = memoryEnv();
+    expect(codes(await send(env, 11, alice))).toContain(429);
+    expect(codes(await send(env, 10, bob))).toEqual(Array(10).fill(200));
+  });
+
+  it("refills one token every 100 ms", async () => {
+    const { env } = memoryEnv();
+    await send(env, 10, alice);
+    vi.setSystemTime(100);
+    expect(codes(await send(env, 2, alice))).toEqual([200, 429]);
+    vi.setSystemTime(1_100);
+    expect(codes(await send(env, 11, alice))).toEqual([...Array(10).fill(200), 429]);
+  });
+
+  it("holds the limit across a Durable Object restart", async () => {
+    const { env, restart } = memoryEnv();
+    await send(env, 10, alice);
+    restart();
+    expect(codes(await send(env, 1, alice))).toEqual([429]);
+  });
+
+  it("names buckets by a token hash or an IP, never the raw token", async () => {
+    const { env, names } = memoryEnv();
+    await send(env, 1, alice);
+    await send(env, 1, { "cf-connecting-ip": "203.0.113.7" });
+    expect(names()).toEqual([expect.stringMatching(/^token:[0-9a-f]{64}$/), "ip:203.0.113.7"]);
+  });
+
+  it("fails closed when there is no limiter", async () => {
+    const error = vi.spyOn(console, "error").mockImplementation(() => {});
+    const res = await app.request("/api/levels");
+    expect(res.status).toBe(503);
+    expect(await res.json()).toEqual({ error: "rate_limiter_unavailable" });
+    error.mockRestore();
+  });
+});
