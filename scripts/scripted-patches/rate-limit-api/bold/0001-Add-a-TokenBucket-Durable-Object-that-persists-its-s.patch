diff --git a/src/api/ratelimit/TokenBucket.ts b/src/api/ratelimit/TokenBucket.ts
new file mode 100644
index 0000000..0cda0d4
--- /dev/null
+++ b/src/api/ratelimit/TokenBucket.ts
@@ -0,0 +1,65 @@
+import { DurableObject } from "cloudflare:workers";
+
+export interface Limit {
+  /** Bucket size: the largest burst allowed. */
+  capacity: number;
+  /** Tokens added per second. */
+  refillPerSecond: number;
+}
+
+/** 10 requests per second per token, bursts of 10. */
+export const API_LIMIT: Limit = { capacity: 10, refillPerSecond: 10 };
+
+export interface Decision {
+  allowed: boolean;
+  limit: number;
+  remaining: number;
+  /** Seconds until the bucket is full again. */
+  resetSeconds: number;
+  /** Seconds until the next token, rounded up (0 when allowed). */
+  retryAfterSeconds: number;
+}
+
+interface Stored {
+  tokens: number;
+  updatedAt: number;
+}
+
+/**
+ * One caller's token bucket. The state is written to Durable Object storage on
+ * every take, so a limit holds across restarts, deploys and evictions, and the
+ * object handles one call at a time, so takes never race.
+ */
+export class TokenBucket extends DurableObject {
+  private stored: Stored | undefined;
+  private readonly loaded: Promise<void>;
+
+  constructor(ctx: DurableObjectState, env: unknown) {
+    super(ctx, env);
+    this.loaded = ctx.blockConcurrencyWhile(async () => {
+      this.stored = await ctx.storage.get<Stored>("bucket");
+    });
+  }
+
+  async take(limit: Limit = API_LIMIT): Promise<Decision> {
+    await this.loaded;
+    const now = Date.now();
+    const previous = this.stored ?? { tokens: limit.capacity, updatedAt: now };
+    const elapsed = Math.max(0, now - previous.updatedAt) / 1000;
+    let tokens = Math.min(limit.capacity, previous.tokens + elapsed * limit.refillPerSecond);
+
+    const allowed = tokens >= 1;
+    if (allowed) tokens -= 1;
+    this.stored = { tokens, updatedAt: now };
+    // Not awaited: the runtime's output gate holds the response until the write is durable.
+    void this.ctx.storage.put("bucket", this.stored);
+
+    return {
+      allowed,
+      limit: limit.capacity,
+      remaining: Math.floor(tokens),
+      resetSeconds: Math.ceil((limit.capacity - tokens) / limit.refillPerSecond),
+      retryAfterSeconds: allowed ? 0 : Math.ceil((1 - tokens) / limit.refillPerSecond),
+    };
+  }
+}
diff --git a/src/cloudflare.d.ts b/src/cloudflare.d.ts
new file mode 100644
index 0000000..2b5c2c0
--- /dev/null
+++ b/src/cloudflare.d.ts
@@ -0,0 +1,34 @@
+// The slice of the Workers runtime types this app uses. Declared here instead of
+// depending on @cloudflare/workers-types for a handful of interfaces.
+
+declare module "cloudflare:workers" {
+  export abstract class DurableObject<Env = unknown> {
+    protected ctx: DurableObjectState;
+    protected env: Env;
+    constructor(ctx: DurableObjectState, env: Env);
+  }
+}
+
+interface DurableObjectStorage {
+  get<T>(key: string): Promise<T | undefined>;
+  put<T>(key: string, value: T): Promise<void>;
+}
+
+interface DurableObjectState {
+  readonly storage: DurableObjectStorage;
+  blockConcurrencyWhile<T>(callback: () => Promise<T>): Promise<T>;
+}
+
+interface DurableObjectId {
+  toString(): string;
+}
+
+/** RPC stub: every public method of T, returning a promise. */
+type DurableObjectStub<T> = {
+  [K in keyof T]: T[K] extends (...args: infer A) => infer R ? (...args: A) => Promise<Awaited<R>> : never;
+};
+
+interface DurableObjectNamespace<T> {
+  idFromName(name: string): DurableObjectId;
+  get(id: DurableObjectId): DurableObjectStub<T>;
+}
