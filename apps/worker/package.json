{
  "name": "@braid/worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c ../../wrangler.jsonc",
    "deploy": "wrangler deploy -c ../../wrangler.jsonc",
    "types": "wrangler types -c ../../wrangler.jsonc ./worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "wrangler d1 migrations apply DB --remote -c ../../wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c ../../wrangler.jsonc",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@braid/protocol": "workspace:*",
    "@cloudflare/puppeteer": "^1.4.0",
    "@cloudflare/sandbox": "1.0.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.28.0",
    "hono": "^4.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "4.149.0"
  }
}
