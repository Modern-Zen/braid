// Headwaters Worker. The config lives at the repo root so the Deploy to Cloudflare button
// (and Workers Builds) can build the whole pnpm workspace: `pnpm run build` then `pnpm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "braid",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": { "enabled": true, "logs": { "enabled": true } },

  // Landing at /, the app at /app/*. The Worker runs first for everything dynamic.
  "assets": {
    "directory": "apps/ui/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/ws/*", "/git/*", "/health", "/app", "/app/*", "/authorize", "/oauth/*", "/.well-known/*", "/connect"]
  },

  "vars": {
    "BRAID_AGENT_MODE": "scripted",
    "BRAID_BASE_DOMAIN": "braid.drp.icu",
    "AI_GATEWAY_ID": "braid",
    "LIVE_MODEL": "claude-sonnet-5-5",
    "BRAID_SCRIPTED_SPEED": "1",
    // Local dev only: start ReviewWorkflow for pushes (Artifacts events fire only when deployed).
    "BRAID_SIMULATE_EVENTS": "0",
    // Repos anyone can clone read-only at /git/<repo>.git (Headwaters' own source, the demo).
    "PUBLIC_REPOS": "river-braid,river-riverlevels"
  },
  // Secrets (none required to deploy; see .dev.vars.example):
  //   ADMIN_TOKEN           operator token: scripts, admin API, app sign-in before Access
  //   CF_ACCOUNT_ID         optional; derived from Artifacts remotes when unset
  //   AI_GATEWAY_TOKEN      live agents + the Claude judge (AI Gateway "braid")
  //   ANTHROPIC_API_KEY     unless the key is stored in AI Gateway (BYOK)
  //   CLOUDFLARE_API_TOKEN  per-Channel preview uploads (Workers Scripts: Edit)

  // One namespace for every River, Channel and Confluence repo.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "braid", "remote": true }],

  // Agents and the sandbox are SQLite-backed Durable Objects, declared through `exports`
  // (mutually exclusive with `migrations`).
  "durable_objects": {
    "bindings": [
      { "name": "RiverAgent", "class_name": "RiverAgent" },
      { "name": "ChannelAgent", "class_name": "ChannelAgent" },
      { "name": "SANDBOX", "class_name": "AgentSandbox" }
    ]
  },
  "exports": {
    "RiverAgent": { "type": "durable-object", "storage": "sqlite" },
    "ChannelAgent": { "type": "durable-object", "storage": "sqlite" },
    "AgentSandbox": { "type": "durable-object", "storage": "sqlite" }
  },
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": { "agent": { "dockerfile": "sandbox/Dockerfile" } }
    }
  ],

  "workflows": [
    { "name": "braid-review", "binding": "REVIEW_WF", "class_name": "ReviewWorkflow" },
    { "name": "braid-confluence", "binding": "CONFLUENCE_WF", "class_name": "ConfluenceWorkflow" }
  ],

  // Every push to any repo in the namespace starts a review. One trigger covers every fork.
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "braid" },
        "targets": [{ "type": "workflow", "workflow_name": "braid-review" }]
      }
    ]
  },

  // Account-level Artifacts events (created / forked / deleted / imported) arrive here
  // through a Queues event subscription. See docs/ARCHITECTURE.md.
  // The producer binding lets `wrangler deploy` provision the queue on a fresh account
  // (consumer-only queues are never auto-created).
  "queues": {
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "braid-artifacts-events" }],
    "consumers": [{ "queue": "braid-artifacts-events", "max_batch_size": 25, "max_batch_timeout": 2 }]
  },

  // No ids: `wrangler deploy` finds these by name, or creates them on a fresh account.
  "d1_databases": [{ "binding": "DB", "database_name": "braid", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "braid-blobs" }],
  // OAuth 2.1 for MCP clients (grants, client registrations, tokens).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" }
}
